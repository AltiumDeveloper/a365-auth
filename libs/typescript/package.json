{
  "name": "@altium-developer/altium-auth",
  "version": "0.2.1",
  "description": "Altium 365 OAuth2 authentication library with PKCE and ActionWait long-polling for browser-based sign-in.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "test:conformance": "vitest run --config test/conformance/vitest.config.ts",
    "test:e2e": "tsx scripts/test-signin.ts",
    "prepublishOnly": "npm run clean && npm run lint && npm run test && npm run build"
  },
  "license": "MIT",
  "author": "Altium Limited (https://www.altium.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AltiumDeveloper/altium-auth.git",
    "directory": "libs/typescript"
  },
  "bugs": {
    "url": "https://github.com/AltiumDeveloper/altium-auth/issues"
  },
  "homepage": "https://github.com/AltiumDeveloper/altium-auth/tree/main/libs/typescript#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "altium",
    "altium365",
    "a365",
    "oauth2",
    "oidc",
    "pkce",
    "authentication",
    "sso",
    "token-exchange"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
