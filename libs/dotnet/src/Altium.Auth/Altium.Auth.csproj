<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 carries .NET Framework 4.6.1+ consumers (MCAD's 4.8 projects). -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Offline-friendly: use the installed runtime patch's on-disk ref pack
         instead of fetching the latest patch from NuGet. -->
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <!-- Dependency-free by design: no *runtime* package references. The only
         package below is StyleCop.Analyzers — a dev-only analyzer (PrivateAssets=all)
         that never ships in the nupkg. -->
    <NuGetAudit>false</NuGetAudit>

    <!-- Code-quality enforcement (the analog of the TS library's ESLint gate):
         built-in .NET analyzers + .editorconfig rules, promoted to build errors so
         the shipped library can't regress on style/naming/quality. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>8.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- NuGet package metadata (nuget.org: Altium.Auth). -->
  <PropertyGroup>
    <PackageId>Altium.Auth</PackageId>
    <VersionPrefix>0.2.1</VersionPrefix>
    <Authors>Altium</Authors>
    <Company>Altium</Company>
    <Product>Altium.Auth</Product>
    <Description>Dependency-free .NET client for Altium 365 authentication (OAuth2/OIDC + PKCE, workspace token-exchange, refresh, and the Altium ActionWait desktop flow). Validated against the language-neutral conformance vectors in the altium-auth spec.</Description>
    <PackageTags>altium;altium365;oauth2;oidc;openid-connect;authentication;pkce</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AltiumDeveloper/altium-auth</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AltiumDeveloper/altium-auth</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ship the library README (libs/dotnet/README.md) as the nuget.org package page. -->
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev-only analyzer (never a runtime/transitive dependency). Enforces the
         structural rules the built-in .NET analyzers don't: SA1402 (one type per
         file) and SA1649 (file name matches the type) — scoped via .editorconfig. -->
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
