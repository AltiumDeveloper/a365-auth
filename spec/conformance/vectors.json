{
  "version": "0.2.0",
  "note": "Language-neutral conformance vectors for the Altium Identity flow. See README.md for the format and matchers. Extracted from src/index.test.ts and the live Commercial, Gov, and AES captures.",

  "authorizeUrl": [
    {
      "id": "authurl-commercial-public",
      "description": "Commercial authorize URL with PKCE; secure must not appear on /authorize and selectWorkspace is absent by default.",
      "config": { "clientId": "test-client-id", "scopes": "openid profile" },
      "options": { "redirectUri": "https://app.example.com/cb", "state": "state-123", "codeVerifier": "verifier-123" },
      "expect": {
        "origin": "https://auth.altium.com",
        "pathname": "/connect/authorize",
        "query": {
          "response_type": "code",
          "client_id": "test-client-id",
          "redirect_uri": "https://app.example.com/cb",
          "scope": "openid profile",
          "code_challenge_method": "S256",
          "code_challenge": "<any>",
          "state": "state-123"
        },
        "queryAbsent": ["secure", "client_secret", "selectWorkspace"]
      }
    },
    {
      "id": "authurl-select-workspace-strict",
      "description": "selectWorkspace=strict appears on /authorize when strict workspace selection is requested (SPEC §3.1).",
      "config": { "clientId": "test-client-id", "scopes": "openid profile" },
      "options": { "state": "s", "codeVerifier": "v", "selectWorkspace": "strict" },
      "expect": {
        "origin": "https://auth.altium.com",
        "pathname": "/connect/authorize",
        "query": { "selectWorkspace": "strict", "code_challenge_method": "S256" },
        "queryAbsent": ["secure"]
      }
    },
    {
      "id": "authurl-select-workspace-optional",
      "description": "selectWorkspace=optional appears on /authorize when optional workspace selection is requested (SPEC §3.1).",
      "config": { "clientId": "test-client-id", "scopes": "openid profile" },
      "options": { "state": "s", "codeVerifier": "v", "selectWorkspace": "optional" },
      "expect": {
        "origin": "https://auth.altium.com",
        "pathname": "/connect/authorize",
        "query": { "selectWorkspace": "optional", "code_challenge_method": "S256" },
        "queryAbsent": ["secure"]
      }
    },
    {
      "id": "authurl-select-workspace-none-omitted",
      "description": "selectWorkspace is absent from /authorize when the value is 'none' (SPEC §3.1 — default/omit).",
      "config": { "clientId": "test-client-id", "scopes": "openid profile" },
      "options": { "state": "s", "codeVerifier": "v", "selectWorkspace": "none" },
      "expect": {
        "origin": "https://auth.altium.com",
        "pathname": "/connect/authorize",
        "queryAbsent": ["selectWorkspace", "secure"]
      }
    },
    {
      "id": "authurl-gov-no-secure",
      "description": "Gov authorize URL targets the gov host but still carries no secure param.",
      "config": {
        "clientId": "gov-client",
        "scopes": "openid profile",
        "authEndpoint": "https://auth.365-gov.altium.com/connect/authorize",
        "tokenEndpoint": "https://auth.365-gov.altium.com/connect/token"
      },
      "options": { "state": "s", "codeVerifier": "v" },
      "expect": {
        "origin": "https://auth.365-gov.altium.com",
        "pathname": "/connect/authorize",
        "query": { "code_challenge_method": "S256" },
        "queryAbsent": ["secure"]
      }
    },
    {
      "id": "authurl-aes-no-secure",
      "description": "AES authorize URL targets the customer-hosted origin under /unifiedlogin and still carries no secure param (AES follows the Commercial rule, SPEC §5.4).",
      "config": {
        "clientId": "aes-client",
        "scopes": "openid profile",
        "authEndpoint": "https://aes.example.com:9785/unifiedlogin/connect/authorize",
        "tokenEndpoint": "https://aes.example.com:9785/unifiedlogin/connect/token",
        "redirectUri": "https://aes.example.com:9785/unifiedlogin/api/AuthComplete"
      },
      "options": { "state": "s", "codeVerifier": "v" },
      "expect": {
        "origin": "https://aes.example.com:9785",
        "pathname": "/unifiedlogin/connect/authorize",
        "query": { "code_challenge_method": "S256", "redirect_uri": "https://aes.example.com:9785/unifiedlogin/api/AuthComplete" },
        "queryAbsent": ["secure", "selectWorkspace"]
      }
    },
    {
      "id": "authurl-aes-workspace-scope-direct",
      "description": "AES hosts one workspace, so its ID is known up front: the workspace scope is requested directly in the initial authorize scope, making the exchange step (SPEC §5.2 — supported on AES, but unnecessary) a no-op. SPEC §6.",
      "config": {
        "clientId": "aes-client",
        "scopes": "openid profile a365:workspace:11111111-1111-1111-1111-111111111111",
        "authEndpoint": "https://aes.example.com:9785/unifiedlogin/connect/authorize",
        "tokenEndpoint": "https://aes.example.com:9785/unifiedlogin/connect/token"
      },
      "options": { "state": "s", "codeVerifier": "v" },
      "expect": {
        "origin": "https://aes.example.com:9785",
        "pathname": "/unifiedlogin/connect/authorize",
        "query": { "scope": "contains:a365:workspace:11111111-1111-1111-1111-111111111111" },
        "queryAbsent": ["secure"]
      }
    }
  ],

  "tokenRequest": [
    {
      "id": "code-exchange-public-commercial",
      "description": "Public client code exchange: client_id in body, no Basic header, no secure.",
      "operation": "exchangeCode",
      "config": { "clientId": "test-client-id", "scopes": "openid profile" },
      "input": { "code": "auth-code", "codeVerifier": "verifier-123", "redirectUri": "https://app.example.com/cb" },
      "expectRequest": {
        "endpoint": "https://auth.altium.com/connect/token",
        "method": "POST",
        "authorization": "none",
        "bodyParams": {
          "grant_type": "authorization_code",
          "code": "auth-code",
          "code_verifier": "verifier-123",
          "redirect_uri": "https://app.example.com/cb",
          "client_id": "test-client-id"
        },
        "bodyParamsAbsent": ["secure", "client_secret"]
      },
      "mockResponse": { "status": 200, "json": { "access_token": "AT", "token_type": "Bearer", "expires_in": 3600, "scope": "openid profile" } },
      "expectResult": { "access_token": "AT", "expires_at": "<any>" }
    },
    {
      "id": "code-exchange-confidential-basic",
      "description": "Confidential client code exchange: HTTP Basic, client_id NOT in body.",
      "operation": "exchangeCode",
      "config": { "clientId": "test-client-id", "clientSecret": "s3cret", "scopes": "openid profile" },
      "input": { "code": "c", "codeVerifier": "v" },
      "expectRequest": {
        "endpoint": "https://auth.altium.com/connect/token",
        "method": "POST",
        "authorization": "basic(clientId:clientSecret)",
        "bodyParams": { "grant_type": "authorization_code", "code": "c", "code_verifier": "v" },
        "bodyParamsAbsent": ["client_id", "secure"]
      },
      "mockResponse": { "status": 200, "json": { "access_token": "AT", "token_type": "Bearer" } },
      "expectResult": { "access_token": "AT" }
    },
    {
      "id": "workspace-exchange-nongov",
      "description": "Non-Gov workspace exchange on the Commercial endpoint; no secure.",
      "operation": "signIntoWorkspace",
      "config": { "clientId": "test-client-id", "scopes": "openid profile" },
      "input": { "baseAccessToken": "global-AT", "workspaceAuthId": "ws-123" },
      "expectRequest": {
        "endpoint": "https://auth.altium.com/connect/token",
        "method": "POST",
        "authorization": "none",
        "bodyParams": {
          "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
          "subject_token": "global-AT",
          "subject_token_type": "urn:ietf:params:oauth:token-type:access_token",
          "scope": "contains:a365:workspace:ws-123",
          "client_id": "test-client-id"
        },
        "bodyParamsAbsent": ["secure"]
      },
      "mockResponse": { "status": 200, "json": { "access_token": "WS-AT", "token_type": "Bearer" } },
      "expectResult": { "access_token": "WS-AT" }
    },
    {
      "id": "workspace-exchange-gov-bridge",
      "description": "Commercial global token → Gov workspace token at the Gov endpoint with secure=1.",
      "operation": "signIntoWorkspace",
      "config": {
        "clientId": "test-client-id",
        "scopes": "openid profile",
        "authEndpoint": "https://auth.365-gov.altium.com/connect/authorize",
        "tokenEndpoint": "https://auth.365-gov.altium.com/connect/token",
        "actionWaitEndpoint": "https://actionwait.altium.com/await",
        "redirectUri": "https://auth.altium.com/api/AuthComplete"
      },
      "input": { "baseAccessToken": "commercial-global-AT", "workspaceAuthId": "gov-ws" },
      "expectRequest": {
        "endpoint": "https://auth.365-gov.altium.com/connect/token",
        "method": "POST",
        "bodyParams": {
          "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
          "subject_token": "commercial-global-AT",
          "scope": "contains:a365:workspace:gov-ws",
          "secure": "1"
        }
      },
      "mockResponse": { "status": 200, "json": { "access_token": "GOV-WS-AT", "token_type": "Bearer" } },
      "expectResult": { "access_token": "GOV-WS-AT" }
    },
    {
      "id": "refresh-commercial-no-scope",
      "description": "Refresh sends grant_type + refresh_token only; no scope, no secure on Commercial.",
      "operation": "refreshToken",
      "config": { "clientId": "test-client-id", "scopes": "openid profile" },
      "input": { "refreshToken": "RT" },
      "expectRequest": {
        "endpoint": "https://auth.altium.com/connect/token",
        "method": "POST",
        "authorization": "none",
        "bodyParams": { "grant_type": "refresh_token", "refresh_token": "RT", "client_id": "test-client-id" },
        "bodyParamsAbsent": ["scope", "secure"]
      },
      "mockResponse": { "status": 200, "json": { "access_token": "AT2", "token_type": "Bearer" } },
      "expectResult": { "access_token": "AT2" }
    },
    {
      "id": "refresh-gov-secure",
      "description": "Refresh at the Gov endpoint carries secure=1; still no scope.",
      "operation": "refreshToken",
      "config": {
        "clientId": "test-client-id",
        "scopes": "openid profile",
        "tokenEndpoint": "https://auth.365-gov.altium.com/connect/token"
      },
      "input": { "refreshToken": "RT" },
      "expectRequest": {
        "endpoint": "https://auth.365-gov.altium.com/connect/token",
        "method": "POST",
        "bodyParams": { "grant_type": "refresh_token", "refresh_token": "RT", "secure": "1" },
        "bodyParamsAbsent": ["scope"]
      },
      "mockResponse": { "status": 200, "json": { "access_token": "AT3", "token_type": "Bearer" } },
      "expectResult": { "access_token": "AT3" }
    },
    {
      "id": "code-exchange-public-aes",
      "description": "Public client code exchange on an AES token endpoint: client_id in body, no Basic header, no secure (AES follows the Commercial rule, SPEC §5.4).",
      "operation": "exchangeCode",
      "config": {
        "clientId": "aes-client",
        "scopes": "openid profile",
        "tokenEndpoint": "https://aes.example.com:9785/unifiedlogin/connect/token",
        "redirectUri": "https://aes.example.com:9785/unifiedlogin/api/AuthComplete"
      },
      "input": { "code": "auth-code", "codeVerifier": "verifier-123" },
      "expectRequest": {
        "endpoint": "https://aes.example.com:9785/unifiedlogin/connect/token",
        "method": "POST",
        "authorization": "none",
        "bodyParams": {
          "grant_type": "authorization_code",
          "code": "auth-code",
          "redirect_uri": "https://aes.example.com:9785/unifiedlogin/api/AuthComplete",
          "client_id": "aes-client"
        },
        "bodyParamsAbsent": ["secure", "client_secret"]
      },
      "mockResponse": { "status": 200, "json": { "access_token": "AES-AT", "token_type": "Bearer", "expires_in": 3600, "scope": "openid profile a365:workspace:11111111-1111-1111-1111-111111111111" } },
      "expectResult": { "access_token": "AES-AT" }
    },
    {
      "id": "workspace-exchange-aes",
      "description": "Workspace exchange at an AES token endpoint: the grant is available on AES and follows the Commercial rule — no secure=1 (SPEC §5.2, §5.4, §6). Rarely needed in practice (a single workspace whose scope is known at sign-in), but it must not be silently mis-shaped if a client does use it.",
      "operation": "signIntoWorkspace",
      "config": {
        "clientId": "aes-client",
        "scopes": "openid profile",
        "authEndpoint": "https://aes.example.com:9785/unifiedlogin/connect/authorize",
        "tokenEndpoint": "https://aes.example.com:9785/unifiedlogin/connect/token"
      },
      "input": { "baseAccessToken": "aes-global-AT", "workspaceAuthId": "11111111-1111-1111-1111-111111111111" },
      "expectRequest": {
        "endpoint": "https://aes.example.com:9785/unifiedlogin/connect/token",
        "method": "POST",
        "authorization": "none",
        "bodyParams": {
          "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
          "subject_token": "aes-global-AT",
          "subject_token_type": "urn:ietf:params:oauth:token-type:access_token",
          "scope": "contains:a365:workspace:11111111-1111-1111-1111-111111111111",
          "client_id": "aes-client"
        },
        "bodyParamsAbsent": ["secure", "client_secret"]
      },
      "mockResponse": { "status": 200, "json": { "access_token": "AES-WS-AT", "token_type": "Bearer" } },
      "expectResult": { "access_token": "AES-WS-AT" }
    },
    {
      "id": "refresh-aes-no-secure",
      "description": "Refresh at an AES token endpoint carries no secure=1 — the host-based Gov heuristic (SPEC §5.4) does not misfire on a non-Altium-hosted host.",
      "operation": "refreshToken",
      "config": {
        "clientId": "aes-client",
        "scopes": "openid profile",
        "tokenEndpoint": "https://aes.example.com:9785/unifiedlogin/connect/token"
      },
      "input": { "refreshToken": "RT" },
      "expectRequest": {
        "endpoint": "https://aes.example.com:9785/unifiedlogin/connect/token",
        "method": "POST",
        "bodyParams": { "grant_type": "refresh_token", "refresh_token": "RT", "client_id": "aes-client" },
        "bodyParamsAbsent": ["scope", "secure"]
      },
      "mockResponse": { "status": 200, "json": { "access_token": "AES-AT2", "token_type": "Bearer" } },
      "expectResult": { "access_token": "AES-AT2" }
    },
    {
      "id": "cross-partition-access-denied",
      "description": "Gov workspace exchanged on the Commercial endpoint → access_denied surfaced as an error.",
      "operation": "signIntoWorkspace",
      "config": { "clientId": "test-client-id", "scopes": "openid profile" },
      "input": { "baseAccessToken": "global-AT", "workspaceAuthId": "gov-ws" },
      "expectRequest": {
        "endpoint": "https://auth.altium.com/connect/token",
        "bodyParamsAbsent": ["secure"]
      },
      "mockResponse": { "status": 400, "json": { "error": "access_denied" } },
      "expectErrorContains": "access_denied"
    },
    {
      "id": "token-expires-at-skew",
      "description": "When the response omits expires_at, the client computes it as now + expires_in - 30 (clock-skew buffer).",
      "operation": "refreshToken",
      "config": { "clientId": "test-client-id", "scopes": "openid profile" },
      "input": { "refreshToken": "RT" },
      "expectRequest": { "endpoint": "https://auth.altium.com/connect/token" },
      "mockResponse": { "status": 200, "json": { "access_token": "AT", "token_type": "Bearer", "expires_in": 3600 } },
      "expectResult": { "access_token": "AT", "expires_at": "epochWithin:3570:5" }
    }
  ],

  "revocation": [
    {
      "id": "revoke-refresh-token",
      "description": "Revoke a refresh token: POST /connect/revocation with token + token_type_hint, client auth per client type; 200 with empty body.",
      "config": { "clientId": "test-client-id", "scopes": "openid profile" },
      "input": { "refreshToken": "RT" },
      "expectRequest": {
        "endpoint": "https://auth.altium.com/connect/revocation",
        "method": "POST",
        "authorization": "none",
        "bodyParams": { "token": "RT", "token_type_hint": "refresh_token", "client_id": "test-client-id" }
      },
      "mockResponse": { "status": 200, "text": "" },
      "note": "Implemented by both the TS (revokeRefreshToken) and .NET (RevokeRefreshTokenAsync) clients; both conformance runners assert this request shape."
    },
    {
      "id": "revoke-then-refresh-invalid-grant",
      "description": "After revoking a refresh token, refreshing with it returns invalid_grant (validated against a live test environment).",
      "mockResponse": { "status": 400, "json": { "error": "invalid_grant" } },
      "expectErrorContains": "invalid_grant",
      "note": "Behavioral reference (revoke → refresh → invalid_grant). Requires a live server, so offline runners skip it. Validated against a live test environment."
    }
  ],

  "userinfo": [
    {
      "id": "userinfo-shape",
      "description": "GET /connect/userinfo returns these claims (see ../schemas/userinfo.schema.json). Validated live in Test B. Not a library function — reference only.",
      "expectClaims": ["sub", "username", "email", "given_name", "family_name", "organization_id", "picture"]
    }
  ],

  "actionWait": [
    {
      "id": "aw-success",
      "description": "200 with data.code/data.state returns the code.",
      "pollResponses": [{ "status": 200, "json": { "data": { "code": "code-1", "state": "<stateEchoesToken>" } } }],
      "expect": { "outcome": "code", "code": "code-1" }
    },
    {
      "id": "aw-reconnect-then-success",
      "description": "408 is a normal reconnect; the next 200 succeeds.",
      "pollResponses": [
        { "status": 408, "text": "" },
        { "status": 200, "json": { "data": { "code": "code-2", "state": "<stateEchoesToken>" } } }
      ],
      "expect": { "outcome": "code", "code": "code-2" }
    },
    {
      "id": "aw-410-terminal",
      "description": "410 is terminal (cancelled / superseded).",
      "pollResponses": [{ "status": 410, "text": "" }],
      "expect": { "outcome": "errorContains", "errorContains": "cancelled" }
    },
    {
      "id": "aw-non-json",
      "description": "200 with a non-JSON body is an error.",
      "pollResponses": [{ "status": 200, "text": "not json" }],
      "expect": { "outcome": "errorContains", "errorContains": "not JSON" }
    },
    {
      "id": "aw-missing-code",
      "description": "200 without data.code is an error.",
      "pollResponses": [{ "status": 200, "json": { "data": {} } }],
      "expect": { "outcome": "errorContains", "errorContains": "missing data.code" }
    },
    {
      "id": "aw-state-mismatch-csrf",
      "description": "200 whose data.state does not match the wait token is rejected (CSRF guard); the code is NOT exchanged.",
      "pollResponses": [{ "status": 200, "json": { "data": { "code": "c", "state": "attacker-state" } } }],
      "expect": { "outcome": "errorContains", "errorContains": "State mismatch" }
    },
    {
      "id": "aw-error-in-data",
      "description": "200 whose data carries a delivered OAuth error (e.g. access_denied — a cross-partition workspace scope requested at sign-in) surfaces that error, not a generic 'missing data.code' (SPEC §4.3).",
      "pollResponses": [{ "status": 200, "json": { "actionResult": "OK", "data": { "error": "access_denied", "state": "<stateEchoesToken>" } } }],
      "expect": { "outcome": "errorContains", "errorContains": "access_denied" }
    }
  ],

  "liveClaims": [
    {
      "id": "claims-global-commercial",
      "description": "Global token from Commercial sign-in (Tests A/B).",
      "scenario": "sign in on auth.altium.com",
      "accessTokenClaims": {
        "iss": "https://auth.altium.com",
        "scopeContains": ["openid", "profile"],
        "secure": "<absent>",
        "workspaceId": "<absent>"
      }
    },
    {
      "id": "claims-workspace-nongov",
      "description": "Non-Gov workspace token (Test A).",
      "scenario": "signIntoWorkspace on auth.altium.com",
      "accessTokenClaims": {
        "iss": "https://auth.altium.com",
        "scopeContains": ["a365:workspace:"],
        "workspaceId": "<present>",
        "secure": "<absent>"
      }
    },
    {
      "id": "claims-workspace-gov",
      "description": "Gov workspace token via Commercial→Gov bridge (Test B).",
      "scenario": "signIntoWorkspace on auth.365-gov.altium.com with secure=1",
      "accessTokenClaims": {
        "iss": "https://auth.365-gov.altium.com",
        "scopeContains": ["a365:workspace:"],
        "workspaceId": "<present>",
        "secure": "1"
      }
    },
    {
      "id": "claims-workspace-aes",
      "description": "AES workspace token — single workspace per installation, requested directly at sign-in (the exchange step is available but unnecessary, and yields the same claims). No workspaceId claim and no secure claim, unlike Commercial/Gov workspace tokens (SPEC §8).",
      "scenario": "signIn on {origin}/unifiedlogin with scope a365:workspace:{id}",
      "accessTokenClaims": {
        "iss": "{origin}/unifiedlogin",
        "scopeContains": ["a365:workspace:"],
        "workspaceId": "<absent>",
        "secure": "<absent>"
      }
    }
  ],

  "clientScopes": [
    {
      "id": "clientscopes-returns-scope-array",
      "description": "GET on the scope endpoint returns the scopes registered for the client, as a JSON array of strings (AES host: includes the installation's single workspace scope).",
      "input": { "scopeEndpoint": "https://aes.example.com:9785/unifiedlogin/api/ClientScopes", "clientId": "test-client-id" },
      "mockResponse": { "status": 200, "json": ["a365:workspace:11111111-1111-1111-1111-111111111111", "openid"] },
      "expectRequest": {
        "endpoint": "https://aes.example.com:9785/unifiedlogin/api/ClientScopes?clientId=test-client-id",
        "method": "GET"
      },
      "expectResult": ["a365:workspace:11111111-1111-1111-1111-111111111111", "openid"]
    },
    {
      "id": "clientscopes-unknown-client-returns-empty-array",
      "description": "An unknown clientId returns an empty JSON array from the endpoint itself (not an error, and not the non-array fallback below).",
      "input": { "scopeEndpoint": "https://aes.example.com:9785/unifiedlogin/api/ClientScopes", "clientId": "unknown-client" },
      "mockResponse": { "status": 200, "json": [] },
      "expectResult": []
    },
    {
      "id": "clientscopes-non-array-body-is-an-error",
      "description": "A 200 whose body is not a JSON array of scope strings is an error, not an empty result: `[]` means \"this client has no scopes\", so a malformed response must never be reported as one.",
      "input": { "scopeEndpoint": "https://aes.example.com:9785/unifiedlogin/api/ClientScopes", "clientId": "test-client-id" },
      "mockResponse": { "status": 200, "json": null },
      "expectErrorContains": "expected a JSON array of strings"
    },
    {
      "id": "clientscopes-non-200-is-an-error",
      "description": "A non-200 response (server error, or an HTML error page from a misconfigured proxy in front of an on-prem installation) surfaces the status and body instead of degrading to an empty scope list.",
      "input": { "scopeEndpoint": "https://aes.example.com:9785/unifiedlogin/api/ClientScopes", "clientId": "test-client-id" },
      "mockResponse": { "status": 500, "text": "<html>Server Error</html>" },
      "expectErrorContains": "500"
    }
  ]
}
